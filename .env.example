# Gmail SMTP Configuration for Inira Innovations
EMAIL_USER=inirainnovations@gmail.com
EMAIL_PASS=your-google-app-password

# Supabase Database Configuration
# 1. Create a free project at https://supabase.com
# 2. Run the SQL script from supabase-schema.sql in the Supabase SQL Editor
# 3. Copy Project URL and Service Role Key (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
